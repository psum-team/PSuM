FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

ARG MIRROR_URL=
RUN echo "Acquire::Retries \"3\";" > /etc/apt/apt.conf.d/80-retries && \
    if [ -n "$MIRROR_URL" ]; then \
      sed -i "s@//.*archive.ubuntu.com@$MIRROR_URL@g" /etc/apt/sources.list && \
      sed -i "s@//.*security.ubuntu.com@$MIRROR_URL@g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    bash git wget curl sed gawk grep tar make cmake g++ \
    lsb-release software-properties-common ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/*

RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /etc/apt/trusted.gpg.d/llvm.gpg && \
    echo "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-16 main" | tee /etc/apt/sources.list.d/llvm.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    llvm-16-dev clang-16 libclang-16-dev clang-tools-16 \
    libomp-16-dev lld-16 \
    libboost-all-dev libopenblas-dev libreadline-dev \
    libsuitesparse-dev libeigen3-dev \
    python3 python3-dev python3-pybind11 python3-numpy python3-venv python3-pip python3-matplotlib python3-pil \
    && rm -rf /var/lib/apt/lists/*

ENV LLVM_DIR=/usr/lib/llvm-16/lib/cmake/llvm
ENV Clang_DIR=/usr/lib/llvm-16/lib/cmake/clang
ENV PATH="/usr/lib/llvm-16/bin:${PATH}"

RUN git clone --depth=1 https://github.com/AdaptiveCpp/AdaptiveCpp.git /tmp/acpp-src \
    && cmake -S /tmp/acpp-src -B /tmp/acpp-build \
       -DCMAKE_INSTALL_PREFIX=/opt/AdaptiveCpp \
       -DLLVM_DIR=$LLVM_DIR \
       -DWITH_ACCEL_CPU=ON \
       -DWITH_ROCM=OFF \
       -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
    && cmake --build /tmp/acpp-build -j$(nproc) \
    && cmake --install /tmp/acpp-build \
    && rm -rf /tmp/acpp-src /tmp/acpp-build

ENV PATH="/opt/AdaptiveCpp/bin:${PATH}"

WORKDIR /workspace

CMD ["/bin/bash"]